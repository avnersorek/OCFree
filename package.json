{
  "name": "openclaw-plugin-opencode-free",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Benchmark free OpenCode models and run repository development tasks with fallback.",
  "license": "MIT",
  "author": "Avner Sorek",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvnerSorek/opencode-free.git"
  },
  "homepage": "https://github.com/AvnerSorek/opencode-free",
  "bugs": {
    "url": "https://github.com/AvnerSorek/opencode-free/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "openclaw",
    "opencode",
    "benchmark",
    "free-models",
    "coding-agent"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "prepack": "npm run build",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "ATTRIBUTIONS.md",
    "SECURITY.md",
    "docs"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "2026.11.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.11.1"
    }
  }
}
